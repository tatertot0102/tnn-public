# Copy to .env for local development. Never commit .env.
# In CI these come from the GitHub "production" environment
# (variable VITE_SUPABASE_URL, secret VITE_SUPABASE_ANON_KEY).

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key. Safe for the browser by design, but keep it out
# of the repo so it can be rotated without a commit.
VITE_SUPABASE_ANON_KEY=

# Optional: canonical site URL used for sitemaps/OG tags (defaults to https://bthstnn.org)
# VITE_SITE_URL=https://bthstnn.org
